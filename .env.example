# Token secreto de tu bot de Discord (Obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=TU_TOKEN_DE_DISCORD_AQUI

# Zona horaria por defecto (ejemplos: America/Bogota, America/Mexico_City, America/Lima, America/Santiago, America/Argentina/Buenos_Aires, Europe/Madrid)
DEFAULT_TIMEZONE=America/Bogota

# Hora predeterminada para los recordatorios diarios (formato 24h, HH:MM)
DEFAULT_REMINDER_TIME=09:00
